{
  "info": {
    "name": "Enterprise Contact & Email API",
    "_postman_id": "b7e5c1a2-9d4f-4e6b-8c3a-1f2e3d4c5b6a",
    "description": "All endpoints for the .NET 10 Contact & Email API. Set {{baseUrl}} and {{apiKey}} in the environment. Business requests authenticate with the X-Api-Key header; the Auth > Issue token request shows the API-key-to-JWT exchange.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Issue JWT (exchange API key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('jwt', json.data.accessToken);",
                  "}",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
